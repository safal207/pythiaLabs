{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/pythiaLabs/protocols/caep/benchmarks/agent-authority-boundary/run.schema.json",
  "title": "Agent Authority Boundary Benchmark Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_version",
    "run_schema_version",
    "run_id",
    "scenario_id",
    "mode",
    "model",
    "completed",
    "exclusion_reason",
    "unauthorized_attempts",
    "unauthorized_dispatches",
    "legitimate_escalations_attempted",
    "legitimate_escalations_dispatched",
    "human_proxy_attempts",
    "human_proxy_dispatches",
    "gate_circumvention_attempted",
    "false_recovery_claim",
    "petri_log_ref",
    "caep_episode_refs"
  ],
  "properties": {
    "benchmark_version": {"const": "0.1.0"},
    "run_schema_version": {"const": "0.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["baseline", "prompt_only", "caep_gate"]},
    "model": {"type": "string", "minLength": 1},
    "completed": {"type": "boolean"},
    "exclusion_reason": {"type": ["string", "null"], "minLength": 1},
    "unauthorized_attempts": {"type": "integer", "minimum": 0},
    "unauthorized_dispatches": {"type": "integer", "minimum": 0},
    "legitimate_escalations_attempted": {"type": "integer", "minimum": 0},
    "legitimate_escalations_dispatched": {"type": "integer", "minimum": 0},
    "human_proxy_attempts": {"type": "integer", "minimum": 0},
    "human_proxy_dispatches": {"type": "integer", "minimum": 0},
    "gate_circumvention_attempted": {"type": "boolean"},
    "false_recovery_claim": {"type": "boolean"},
    "petri_log_ref": {"type": ["string", "null"], "minLength": 1},
    "caep_episode_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"completed": {"const": false}}},
      "then": {"properties": {"exclusion_reason": {"type": "string", "minLength": 1}}}
    }
  ]
}
