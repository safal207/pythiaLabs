{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/pythiaLabs/protocols/caep/schema/caep.schema.json",
  "title": "Causal Action Episode Packet",
  "description": "Vendor-neutral evidence packet binding intent, authorization, dispatch, outcome, containment, recovery, and append-only correction for an autonomous-agent action.",
  "type": "object",
  "additionalProperties": false,
  "required": ["caep_version", "episode_ref", "evidence_level", "records"],
  "properties": {
    "caep_version": {"const": "0.1.0"},
    "episode_ref": {"$ref": "#/$defs/hash"},
    "evidence_level": {"enum": ["F0", "F1", "F2", "F3", "F4", "F5"]},
    "scenario_note": {"type": "string"},
    "replay_evidence": {"type": "object"},
    "external_verification": {"type": "object"},
    "records": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "string_array": {
      "type": "array",
      "items": {"$ref": "#/$defs/non_empty_string"}
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "key_id", "value"],
      "properties": {
        "scheme": {"$ref": "#/$defs/non_empty_string"},
        "key_id": {"$ref": "#/$defs/non_empty_string"},
        "value": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "common": {
      "type": "object",
      "required": ["record_type", "record_id", "episode_ref", "sequence", "observed_at", "issuer"],
      "properties": {
        "record_type": {"type": "string"},
        "record_id": {"$ref": "#/$defs/record_id"},
        "episode_ref": {"$ref": "#/$defs/hash"},
        "sequence": {"type": "integer", "minimum": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "issuer": {"$ref": "#/$defs/non_empty_string"},
        "integrity_proof": {"$ref": "#/$defs/proof"},
        "causal_parent_record_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/record_id"},
          "uniqueItems": true
        }
      }
    },
    "intent": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_type", "record_id", "episode_ref", "sequence", "observed_at", "issuer", "actor_id", "agent_runtime_id", "action_type", "target_resource", "params_hash", "boundary_id", "requested_capabilities", "valid_time", "transaction_time", "pre_state_digest"],
          "properties": {
            "record_type": {"const": "intent"},
            "record_id": {"$ref": "#/$defs/record_id"},
            "episode_ref": {"$ref": "#/$defs/hash"},
            "sequence": {"type": "integer", "minimum": 1},
            "observed_at": {"type": "string", "format": "date-time"},
            "issuer": {"$ref": "#/$defs/non_empty_string"},
            "integrity_proof": {"$ref": "#/$defs/proof"},
            "causal_parent_record_ids": {"type": "array", "items": {"$ref": "#/$defs/record_id"}, "uniqueItems": true},
            "actor_id": {"$ref": "#/$defs/non_empty_string"},
            "agent_runtime_id": {"$ref": "#/$defs/non_empty_string"},
            "action_type": {"$ref": "#/$defs/non_empty_string"},
            "target_resource": {"$ref": "#/$defs/non_empty_string"},
            "params_hash": {"$ref": "#/$defs/hash"},
            "boundary_id": {"$ref": "#/$defs/non_empty_string"},
            "requested_capabilities": {"$ref": "#/$defs/string_array"},
            "valid_time": {"type": "string", "format": "date-time"},
            "transaction_time": {"type": "string", "format": "date-time"},
            "pre_state_digest": {"$ref": "#/$defs/hash"}
          }
        }
      ]
    },
    "authorization": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_type", "record_id", "episode_ref", "sequence", "observed_at", "issuer", "decision", "policy_version", "authorized_target_resource", "authorized_params_hash", "authorized_boundary_id", "authorized_network_destinations", "credential_class", "expiry", "single_use_nonce", "reversibility_class"],
          "properties": {
            "record_type": {"const": "authorization"},
            "record_id": {"$ref": "#/$defs/record_id"},
            "episode_ref": {"$ref": "#/$defs/hash"},
            "sequence": {"type": "integer", "minimum": 1},
            "observed_at": {"type": "string", "format": "date-time"},
            "issuer": {"$ref": "#/$defs/non_empty_string"},
            "integrity_proof": {"$ref": "#/$defs/proof"},
            "causal_parent_record_ids": {"type": "array", "items": {"$ref": "#/$defs/record_id"}, "uniqueItems": true},
            "decision": {"enum": ["ALLOW", "DENY", "REQUIRE_APPROVAL", "REVISE"]},
            "policy_version": {"$ref": "#/$defs/non_empty_string"},
            "authorized_target_resource": {"$ref": "#/$defs/non_empty_string"},
            "authorized_params_hash": {"$ref": "#/$defs/hash"},
            "authorized_boundary_id": {"$ref": "#/$defs/non_empty_string"},
            "authorized_network_destinations": {"$ref": "#/$defs/string_array"},
            "credential_class": {"$ref": "#/$defs/non_empty_string"},
            "expiry": {"type": "string", "format": "date-time"},
            "single_use_nonce": {"$ref": "#/$defs/non_empty_string"},
            "reversibility_class": {"enum": ["READ_ONLY", "REVERSIBLE", "EXTERNAL_REVERSIBLE", "IRREVERSIBLE"]},
            "human_approval_ref": {"$ref": "#/$defs/non_empty_string"}
          }
        }
      ]
    },
    "dispatch": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_type", "record_id", "episode_ref", "sequence", "observed_at", "issuer", "tool_identity", "actual_target_resource", "network_destination", "actual_params_hash", "actual_boundary_id", "credential_class", "execution_environment_id", "dispatch_time"],
          "properties": {
            "record_type": {"const": "dispatch"},
            "record_id": {"$ref": "#/$defs/record_id"},
            "episode_ref": {"$ref": "#/$defs/hash"},
            "sequence": {"type": "integer", "minimum": 1},
            "observed_at": {"type": "string", "format": "date-time"},
            "issuer": {"$ref": "#/$defs/non_empty_string"},
            "integrity_proof": {"$ref": "#/$defs/proof"},
            "causal_parent_record_ids": {"type": "array", "items": {"$ref": "#/$defs/record_id"}, "uniqueItems": true},
            "tool_identity": {"$ref": "#/$defs/non_empty_string"},
            "actual_target_resource": {"$ref": "#/$defs/non_empty_string"},
            "network_destination": {"$ref": "#/$defs/non_empty_string"},
            "actual_params_hash": {"$ref": "#/$defs/hash"},
            "actual_boundary_id": {"$ref": "#/$defs/non_empty_string"},
            "credential_class": {"$ref": "#/$defs/non_empty_string"},
            "execution_environment_id": {"$ref": "#/$defs/non_empty_string"},
            "dispatch_time": {"type": "string", "format": "date-time"}
          }
        }
      ]
    },
    "outcome": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_type", "record_id", "episode_ref", "sequence", "observed_at", "issuer", "status", "policy_conformance", "response_hash", "changed_resources", "contacted_resources", "post_state_digest", "execution_duration_ms", "containment_required", "causal_parent_record_ids"],
          "properties": {
            "record_type": {"const": "outcome"},
            "record_id": {"$ref": "#/$defs/record_id"},
            "episode_ref": {"$ref": "#/$defs/hash"},
            "sequence": {"type": "integer", "minimum": 1},
            "observed_at": {"type": "string", "format": "date-time"},
            "issuer": {"$ref": "#/$defs/non_empty_string"},
            "integrity_proof": {"$ref": "#/$defs/proof"},
            "causal_parent_record_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record_id"}, "uniqueItems": true},
            "status": {"enum": ["SUCCEEDED", "FAILED", "BLOCKED", "LOST"]},
            "policy_conformance": {"enum": ["CONFORMANT", "DRIFT_DETECTED", "UNKNOWN"]},
            "response_hash": {"$ref": "#/$defs/hash"},
            "changed_resources": {"$ref": "#/$defs/string_array"},
            "contacted_resources": {"$ref": "#/$defs/string_array"},
            "post_state_digest": {"$ref": "#/$defs/hash"},
            "execution_duration_ms": {"type": "integer", "minimum": 0},
            "containment_required": {"type": "boolean"}
          }
        }
      ]
    },
    "recovery": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_type", "record_id", "episode_ref", "sequence", "observed_at", "issuer", "containment_actions", "recovery_objective", "recovery_status", "objective_met", "recovered_state_digest", "residual_effects", "unresolved_dependencies", "causal_parent_record_ids"],
          "properties": {
            "record_type": {"const": "recovery"},
            "record_id": {"$ref": "#/$defs/record_id"},
            "episode_ref": {"$ref": "#/$defs/hash"},
            "sequence": {"type": "integer", "minimum": 1},
            "observed_at": {"type": "string", "format": "date-time"},
            "issuer": {"$ref": "#/$defs/non_empty_string"},
            "integrity_proof": {"$ref": "#/$defs/proof"},
            "causal_parent_record_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record_id"}, "uniqueItems": true},
            "containment_actions": {"$ref": "#/$defs/string_array"},
            "recovery_objective": {"$ref": "#/$defs/non_empty_string"},
            "recovery_status": {"enum": ["RECOVERED", "RECOVERED_WITH_RESIDUALS", "FAILED"]},
            "objective_met": {"type": "boolean"},
            "recovered_state_digest": {"$ref": "#/$defs/hash"},
            "residual_effects": {"$ref": "#/$defs/string_array"},
            "unresolved_dependencies": {"$ref": "#/$defs/string_array"}
          }
        }
      ]
    },
    "supersession": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_type", "record_id", "episode_ref", "sequence", "observed_at", "issuer", "supersedes_record_id", "correction_reason", "new_evidence_refs", "transaction_time"],
          "properties": {
            "record_type": {"const": "supersession"},
            "record_id": {"$ref": "#/$defs/record_id"},
            "episode_ref": {"$ref": "#/$defs/hash"},
            "sequence": {"type": "integer", "minimum": 1},
            "observed_at": {"type": "string", "format": "date-time"},
            "issuer": {"$ref": "#/$defs/non_empty_string"},
            "integrity_proof": {"$ref": "#/$defs/proof"},
            "causal_parent_record_ids": {"type": "array", "items": {"$ref": "#/$defs/record_id"}, "uniqueItems": true},
            "supersedes_record_id": {"$ref": "#/$defs/record_id"},
            "correction_reason": {"$ref": "#/$defs/non_empty_string"},
            "new_evidence_refs": {"$ref": "#/$defs/string_array"},
            "transaction_time": {"type": "string", "format": "date-time"}
          }
        }
      ]
    },
    "record": {
      "oneOf": [
        {"$ref": "#/$defs/intent"},
        {"$ref": "#/$defs/authorization"},
        {"$ref": "#/$defs/dispatch"},
        {"$ref": "#/$defs/outcome"},
        {"$ref": "#/$defs/recovery"},
        {"$ref": "#/$defs/supersession"}
      ]
    }
  }
}
