{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/pythiaLabs/protocols/caep/schema/caep-ir-fields.schema.json",
  "title": "CAEP OWASP AI Incident Response field profile",
  "description": "Backward-compatible companion field profile for explicit gate paths and reversibility-conditioned incident evidence.",
  "oneOf": [
    {
      "title": "Authorization gate path",
      "type": "object",
      "required": [
        "record_type",
        "decision",
        "gate_path",
        "reversibility_class"
      ],
      "properties": {
        "record_type": {
          "const": "authorization"
        },
        "decision": {
          "enum": [
            "ALLOW",
            "DENY",
            "REQUIRE_APPROVAL",
            "REVISE"
          ]
        },
        "gate_path": {
          "enum": [
            "AUTO_EXECUTED",
            "APPROVAL_GATED",
            "BLOCKED",
            "ESCALATED"
          ]
        },
        "reversibility_class": {
          "enum": [
            "READ_ONLY",
            "REVERSIBLE",
            "EXTERNAL_REVERSIBLE",
            "IRREVERSIBLE"
          ]
        }
      },
      "additionalProperties": true
    },
    {
      "title": "Irreversible outcome incident evidence",
      "type": "object",
      "required": [
        "record_type",
        "incident_state",
        "containment_status",
        "residual_effects",
        "unresolved_dependencies"
      ],
      "properties": {
        "record_type": {
          "const": "outcome"
        },
        "incident_state": {
          "const": "NON_RECOVERABLE"
        },
        "containment_status": {
          "enum": [
            "PENDING",
            "IN_PROGRESS",
            "CONTAINED",
            "FAILED"
          ]
        },
        "residual_effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unresolved_dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    }
  ]
}
