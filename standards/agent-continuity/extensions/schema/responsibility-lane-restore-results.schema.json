{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/pythiaLabs/standards/agent-continuity/extensions/schema/responsibility-lane-restore-results.schema.json",
  "title": "Responsibility Lane Restore Results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extension_id",
    "lane_checks"
  ],
  "properties": {
    "schema_version": {
      "const": "rlc-restore/0.1"
    },
    "extension_id": {
      "type": "string",
      "minLength": 1
    },
    "lane_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/laneCheck"
      }
    }
  },
  "$defs": {
    "laneCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "lane_id",
        "status",
        "observed_lane_digest",
        "source_refs_checked",
        "conflict_refs"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "lane_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "pending",
            "failed",
            "conflict"
          ]
        },
        "observed_lane_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_refs_checked": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "conflict_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
