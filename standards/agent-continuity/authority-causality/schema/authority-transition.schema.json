{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safal207.github.io/pythiaLabs/aci/authority-transition.schema.json",
  "title": "ACI Authority Transition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transition_id", "kind", "resource_ref", "expected_previous_authority_digest", "expected_previous_epoch", "from_owner_ref", "to_owner_ref", "new_epoch", "new_scope"],
  "properties": {
    "schema_version": {"const": "aci-transition/0.1"},
    "transition_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["assign", "transfer", "delegate", "revoke", "expire"]},
    "resource_ref": {"type": "string", "minLength": 1},
    "expected_previous_authority_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "expected_previous_epoch": {"type": "integer", "minimum": -1},
    "from_owner_ref": {"type": ["string", "null"]},
    "to_owner_ref": {"type": ["string", "null"]},
    "new_epoch": {"type": "integer", "minimum": 0},
    "new_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
