{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/pythiaLabs/standards/agent-actions/schema/github-pr-merge-gate-input.schema.json",
  "title": "PythiaLabs GitHub PR Merge Gate Input v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "decision_time",
    "actor",
    "repository",
    "pull_request",
    "authorization",
    "required_checks",
    "checks",
    "required_reviews",
    "reviews",
    "recovery"
  ],
  "properties": {
    "schema_version": {
      "const": "pythia.github_pr_merge_gate.v0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_time": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "agent_id"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1},
        "agent_id": {"type": "string", "minLength": 1}
      }
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "base_ref",
        "state",
        "mergeable",
        "expected_head_sha",
        "observed_head_sha",
        "observed_at",
        "expires_at"
      ],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "base_ref": {"type": "string", "minLength": 1},
        "state": {"const": "open"},
        "mergeable": {"type": ["boolean", "null"]},
        "expected_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "observed_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "actor_id",
        "granted_to",
        "capability",
        "operation",
        "target",
        "environment",
        "valid_from",
        "valid_until",
        "delegation_chain"
      ],
      "properties": {
        "authorization_id": {"type": "string", "minLength": 1},
        "actor_id": {"type": "string", "minLength": 1},
        "granted_to": {"type": "string", "minLength": 1},
        "capability": {"const": "repository.merge"},
        "operation": {"const": "merge_pull_request"},
        "target": {"type": "string", "minLength": 1},
        "environment": {"const": "github"},
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "delegation_chain": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "maxItems": 20
        }
      }
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "conclusion",
          "head_sha",
          "observed_at",
          "expires_at",
          "run_ref"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "conclusion": {
            "enum": ["success", "failure", "cancelled", "pending"]
          },
          "head_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "observed_at": {"type": "string", "format": "date-time"},
          "expires_at": {"type": "string", "format": "date-time"},
          "run_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_reviews": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewer",
          "reviewer_type",
          "verdict",
          "head_sha",
          "submitted_at",
          "expires_at",
          "review_ref"
        ],
        "properties": {
          "reviewer": {"type": "string", "minLength": 1},
          "reviewer_type": {"enum": ["human", "code_review_bot"]},
          "verdict": {
            "enum": ["approved", "changes_requested", "pending"]
          },
          "head_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "submitted_at": {"type": "string", "format": "date-time"},
          "expires_at": {"type": "string", "format": "date-time"},
          "review_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rollback_required",
        "rollback_available",
        "rollback_ref"
      ],
      "properties": {
        "rollback_required": {"type": "boolean"},
        "rollback_available": {"type": "boolean"},
        "rollback_ref": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rollback_available": {"const": true}
            }
          },
          "then": {
            "properties": {
              "rollback_ref": {"type": "string"}
            }
          }
        }
      ]
    }
  }
}
